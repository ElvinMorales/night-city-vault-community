{
  "name": "night-city-vault-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "audit:content": "node scripts/check-public-content.mjs",
    "check": "npm run test && npm run build && npm run test:pages && npm run audit:content && npm run test:browser && npm run test:pwa && npm run test:mobile && npm run test:ux",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "catalog:extract": "node scripts/extract-archive.mjs",
    "catalog:build": "node --experimental-strip-types scripts/build-archive.mjs",
    "audit:release": "node scripts/check-public-content.mjs --release",
    "test:pwa": "node scripts/pwa-browser-tests.mjs",
    "test:mobile": "node scripts/mobile-ux-tests.mjs",
    "test:visual": "COMMUNITY_COMPARE_VISUALS=1 node scripts/mobile-ux-tests.mjs",
    "test:ux": "node scripts/phase-3d-ux-tests.mjs",
    "test:pages": "node scripts/check-pages-artifact.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
